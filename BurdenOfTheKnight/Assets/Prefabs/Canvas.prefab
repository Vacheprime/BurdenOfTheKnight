--- !u!114 &8375760669113282086
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2861438770571542574}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "You are armed with a <color=#5C0000>shortsword</color>, forged for swift
    strikes and precise blows. Time your slashes and thrusts well, for every swing
    demands <color=#5C0000>stamina</color>. Angle your blade with care\u2014some
    foes will guard against certain strikes, and only a well-placed attack will break
    their defense.\n\nWhen <color=#5C0000>paired with the shortsword</color>, you
    wield a shield\u2014your steadfast guardian against steel and claw. Time your
    defense well; a late block will still wound you, and every guard drains your
    stamina. But master your reflexes, and a perfect block will turn aside the blow
    without cost, leaving your strength unbroken."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 7324ebd53b455b44bba26fe21c53ccfe, type: 2}
  m_sharedMaterial: {fileID: 4951025827777655092, guid: 7324ebd53b455b44bba26fe21c53ccfe, type: 2}

      m_Calls: []
  m_text: "Use<color=#5C0000> W, A, S, D</color> to move through the castle\u2019s
    halls and<color=#5C0000> E</color> to interact with the world around you. Swing
    your blade or cast spells with the <color=#5C0000>left mouse button</color>,
    and perform stronger attacks or alternate spells with the <color=#5C0000> right</color>.
    \n\n <color=#5C0000>Hold Q</color> to block incoming blows or defend with magic.
    You can run or break away from combat by <color=#5C0000> holding Shift</color>,
    and switch between weapons or spells with the  <color=#5C0000>number keys</color>.
    \n\nUse <color=#5C0000> Space </color>to change your locked target, and  <color=#5C0000>Esc</color>
    to pause your journey when needed."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 7324ebd53b455b44bba26fe21c53ccfe, type: 2}

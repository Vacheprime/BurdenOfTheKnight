  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The spellsword can wield  <color=#5C0000>destruction magic</color> to
    strike from afar. <color=#5C0000> Fire </color>burns enemies, effective against
    both physical and magical foes. <color=#5C0000> Ice </color>slows targets, giving
    you an edge against melee opponents. <color=#5C0000> Thunder </color>paralyzes,
    disrupting magical foes more than physical ones. \n\n <color=#5C0000>Draining
    Magic</color> restores health and stamina, though at a high cost of magic points.
    Magic is powerful but leaves you vulnerable\u2014timing is key. \n\nSuccessfully 
    <color=#5C0000>blocking with magic </color>avoids damage at the cost of some
    magic points, while failed blocks still allow enemies to strike."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 7324ebd53b455b44bba26fe21c53ccfe, type: 2}
